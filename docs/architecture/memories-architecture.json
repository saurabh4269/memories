  "cards": [
    {
      "dot": "cyan",
      "title": "Reel flow (numbers on arrows)",
      "items": [
        "1 Phone backs up photos and videos to Immich",
        "2 Immich makes thumbnails, runs faces and CLIP in Immich ML",
        "3 Poller analyses new assets: keyframes, contact sheets, gemma4, team score (Facet scores planned)",
        "4 User speaks a prompt in the app (POST /director/v1/reels)",
        "5 Dictate turns speech into an intent",
        "6 Flagsmith picks single_shot or agentic, sarvam-105b plans with tools over Immich",
        "7 Code validates the EDL: ids, trims, beat, length",
        "8 Segments render in parallel from originals",
        "9 Two previews return, finals render speculatively",
        "10 Share via Android share sheet, or Postiz",
        "11 reel_shared goes to Flagsmith as the experiment metric"
      ]
    },
    {
      "dot": "amber",
      "title": "Sponsor tools",
      "items": [
        "Sarvam AI: shot analysis, director with tools, speech to intent, invite cards, translation, voiceover",
        "Flagsmith: experiment, elder_mode segment, shot_coach rollout, render_profile/peak_mode, ml_lite_mode kill switch, Feature Health",
        "NudgeBee: watches Immich ML in k3s, RCA, workflow memories-ml-surge with human approval"
      ]
    },
    {
      "dot": "violet",
      "title": "Sync vs async",
      "items": [
        "Solid: request path the user waits on",
        "Dashed: background or fire-and-forget (ML jobs, poller, Postiz)",
        "Red: ops path from NudgeBee into Flagsmith",
        "No inbound port for NudgeBee: the agent dials out"
      ]
    }
  ]
