# Copy to deploy/.vm.env (gitignored) and replace the placeholders.
# Scripts source this file when it exists. A variable already set in the
# environment is kept; otherwise the value after :- is used.
# $HOME is expanded when the file is sourced.

# Public IP or DNS name of the VM (required by vm.sh, tunnel.sh, surge/run.sh).
MEMORIES_VM_HOST="${MEMORIES_VM_HOST:-203.0.113.10}"

# SSH login. Azure's default admin user is azureuser.
MEMORIES_VM_USER="${MEMORIES_VM_USER:-azureuser}"

# Private key for ssh and scp.
MEMORIES_SSH_KEY="${MEMORIES_SSH_KEY:-$HOME/.ssh/id_ed25519}"

# VM resource name. Documented in deploy/README.md; the scripts do not read it.
MEMORIES_VM_NAME="${MEMORIES_VM_NAME:-your-vm-name}"

# kubectl context inside MEMORIES_KUBECONFIG, for a local client through tunnel.sh.
MEMORIES_KUBE_CONTEXT="${MEMORIES_KUBE_CONTEXT:-your-kube-context}"

# kubeconfig for that local client (export KUBECONFIG after starting the tunnel).
MEMORIES_KUBECONFIG="${MEMORIES_KUBECONFIG:-$HOME/.kube/config}"

# Key files sourced by deploy/env.sh. The second file is optional.
MEMORIES_ENV_FILE="${MEMORIES_ENV_FILE:-$HOME/path/to/app.env}"
MEMORIES_IMMICH_ENV="${MEMORIES_IMMICH_ENV:-$HOME/path/to/immich.env}"
